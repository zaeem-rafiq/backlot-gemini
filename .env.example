# Google Gemini API Key (Required for AI Agents)
# Free-tier keys support text models (gemini-3.5-flash, gemini-2.5-flash)
# Billed keys enable Gemini Imagen / visual rendering models
GEMINI_API_KEY=

# Parallel Partner Search API Key (Required for Marquee Live Market Research)
PARALLEL_API_KEY=

# Optional Model Overrides (defaults to certified fallback chains)
# MODEL_REASONING_OVERRIDE=gemini-3.5-flash
# MODEL_FAST_OVERRIDE=gemini-3.1-flash-lite
# MODEL_IMAGE_OVERRIDE=gemini-3.1-flash-image
