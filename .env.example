# ==============================================================================
# BACKLOT STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI MODEL ACCESS (Choose Path A or Path B)
# ------------------------------------------------------------------------------

# Path A: Gemini Developer API (Recommended for Local Dev)
# Generate key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Path B: Gemini Enterprise Agent Platform / Vertex AI (Production Cloud Run)
# Authenticated automatically via Application Default Credentials (ADC) or Service Account.
# Set USE_VERTEX=true to route calls via Vertex AI / Gemini Enterprise Agent Platform
USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=global

# ------------------------------------------------------------------------------
# 2. PARALLEL PARTNER SEARCH API (Market Intelligence Track)
# ------------------------------------------------------------------------------
# API Key for Parallel Search API (https://api.parallel.ai/v1beta/search).
# In production Cloud Run, can also be mounted from Secret Manager as PARALLEL_API_KEY.
PARALLEL_API_KEY=

# ------------------------------------------------------------------------------
# 3. MANAGED GOOGLE AGENT RUNTIME / VERTEX AI REASONING ENGINE (Marquee Stage)
# ------------------------------------------------------------------------------
# In production, Backlot strictly requires the canonical ReasoningEngine resource name:
# Format: projects/{PROJECT_NUMBER}/locations/{REGION}/reasoningEngines/{REASONING_ENGINE_ID}
# The client automatically derives the query endpoint (https://{REGION}-aiplatform.googleapis.com/v1/{RESOURCE_NAME}:query)
VERTEX_REASONING_ENGINE_RESOURCE_NAME=

# Non-production / Local mock endpoint override (e.g. for testing local container)
# MARQUEE_AGENT_URL=http://127.0.0.1:8080/api/reasoning_engine

# ------------------------------------------------------------------------------
# 4. CERTIFIED MODEL OVERRIDES (Defaults to Verified Gemini Fallback Chains)
# ------------------------------------------------------------------------------
# Default reasoning: gemini-3.8-flash -> gemini-3.5-flash -> gemini-3-flash-preview -> gemini-2.5-flash -> gemini-2.5-pro
# MODEL_REASONING_OVERRIDE=gemini-3.8-flash

# Default fast synthesis: gemini-3.8-flash -> gemini-3.1-flash-lite -> gemini-2.5-flash-lite -> gemini-2.5-flash
# MODEL_FAST_OVERRIDE=gemini-3.8-flash

# Default visual previz: gemini-2.5-flash-image -> gemini-3.1-flash-image -> gemini-3-pro-image
# MODEL_IMAGE_OVERRIDE=gemini-2.5-flash-image

