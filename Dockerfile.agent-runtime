# Stage 1: Build & bundle
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build:runtime

# Stage 2: Runner (Google Agent Runtime BYOC custom container)
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV AIP_HTTP_PORT=8080
ENV PORT=8080
ENV AIP_HEALTH_ROUTE=/health
ENV AIP_PREDICT_ROUTE=/predict

RUN addgroup -g 1001 -S nodejs && \
    adduser -S agentruntime -u 1001 -G nodejs

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist/agent-runtime ./dist/agent-runtime

USER agentruntime

EXPOSE 8080

CMD ["node", "dist/agent-runtime/marquee-server.mjs"]
